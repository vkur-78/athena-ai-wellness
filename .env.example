# ==============================================================================
# Athena — Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or backend/.env and frontend/.env.local) and fill in
# your own keys. NEVER commit actual production secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------

# OpenAI API Key (used for conversational AI, reflection generation, insights)
OPENAI_API_KEY=

# OpenAI Model identifier (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Key (used for automatic failover)
GEMINI_API_KEY=

# Gemini Model identifier (defaults to gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# Gemini OpenAI-compatible base URL
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Supabase Project URL
SUPABASE_URL=

# Supabase Service Role Secret Key (server-side only, never expose to client)
SUPABASE_SERVICE_KEY=

# Supabase JWKS URL (optional, for offline/asymmetric JWT verification)
SUPABASE_JWKS_URL=

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env.local)
# ------------------------------------------------------------------------------

# Supabase Public API URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Public Anonymous Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Frontend API base path (/api when using Next.js proxy rewrite, or full URL)
NEXT_PUBLIC_API_URL=/api

# Backend upstream target for Next.js /api rewrite proxy
# Local: http://127.0.0.1:8001
# Production: https://your-backend-host.domain.com
BACKEND_URL=http://127.0.0.1:8001
